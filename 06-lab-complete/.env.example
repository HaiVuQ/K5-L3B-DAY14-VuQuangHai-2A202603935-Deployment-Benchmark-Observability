# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt key thật qua .env hoặc biến môi trường của platform
AGENT_API_KEY=change-me

# Redis (docker compose ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit & cost guard
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
